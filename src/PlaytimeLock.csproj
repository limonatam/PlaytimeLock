<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>PlaytimeLock</AssemblyName>
    <RootNamespace>PlaytimeLock</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <Authors>Ataberk</Authors>
    <Product>PlaytimeLock</Product>
    <Description>Playnite extension: lock game playtime so store sync cannot reset it.</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Playnite provides Playnite.SDK.dll at runtime, so it is not copied to the output -->
    <PackageReference Include="PlayniteSDK" Version="6.11.0" ExcludeAssets="runtime" />
    <!-- Lets "dotnet build" target .NET Framework 4.6.2 without Visual Studio installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
